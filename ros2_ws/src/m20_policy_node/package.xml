<?xml version="1.0"?>
<package format="3">
  <name>m20_policy_node</name>
  <version>0.1.0</version>
  <description>External ROS 2 inference node for the M20 locomotion policy trained in locomotion_training.</description>
  <maintainer email="noreply@example.com">slam</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>grid_map_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>isaac_fastlio_adapter</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
